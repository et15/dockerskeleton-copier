# Example .env — safe to commit, contains no real secrets.
#
# Every key here is passed to every service with `env_file: .env`, so keep
# it to values that are fine for all of them. Secret references (*_FILE)
# belong in each service's own `environment:` in docker-compose.yaml, next
# to the `secrets:` entry that actually mounts the file.
TZ=Europe/Berlin
